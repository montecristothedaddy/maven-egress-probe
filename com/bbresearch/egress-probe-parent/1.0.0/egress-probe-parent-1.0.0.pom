<?xml version="1.0" encoding="UTF-8"?>
<!--
  AUTHORIZED SECURITY RESEARCH FIXTURE - GitHub Security Bug Bounty (HackerOne: github).
  Inert Maven metadata. No code, no executable content. GET requests only.

  RUN 3: does the permitted .githubapp.com reach a REAL internal service?

  Runs 1 and 2 proved: the injection works against the hosted service, the egress
  allowlist IS enforcing (proxy-egress-enforce: true in the job definition), and it
  REFUSES .github.net while PERMITTING .githubapp.com. What is still unproven is
  whether anything real answers on the permitted domain.

  Every candidate below is NXDOMAIN on the public internet (measured 2026-11-06), so
  each is either absent entirely or resolvable only inside GitHub's network. None is
  on the programme's githubapp.com exclusion list (atom-io, atom-io-staging,
  email.enterprise-staging, email.haystack, reply).

  DELIBERATELY NOT USED: bastion.githubapp.com and ops.githubapp.com both resolve
  PUBLICLY, so reaching those would be "public internet" egress, which this
  programme states is an INELIGIBLE escape. They are excluded on purpose.

  dependabot-core reports only `forbidden_urls.first`, and only a 401/403 lands
  there. The control is LAST, so:
    reported host is a githubapp.com name -> a real internal service answered with
                                             an auth gate. That is internal reach.
    reported host is the .github.net one  -> no candidate auth-gated; read the proxy
                                             log for what each one actually did.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.bbresearch</groupId>
  <artifactId>egress-probe-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <repositories>
    <repository>
      <id>c1-haystack</id>
      <url>http://haystack.githubapp.com/c1</url>
    </repository>
    <repository>
      <id>c2-help</id>
      <url>http://help.githubapp.com/c2</url>
    </repository>
    <repository>
      <id>c3-admin</id>
      <url>http://admin.githubapp.com/c3</url>
    </repository>
    <repository>
      <id>c4-internal</id>
      <url>http://internal.githubapp.com/c4</url>
    </repository>
    <repository>
      <id>c5-blog</id>
      <url>http://blog.githubapp.com/c5</url>
    </repository>
    <repository>
      <id>control-githubnet-known-refused</id>
      <url>http://nonexistent-9f3a2b.github.net/control</url>
    </repository>
  </repositories>
</project>
