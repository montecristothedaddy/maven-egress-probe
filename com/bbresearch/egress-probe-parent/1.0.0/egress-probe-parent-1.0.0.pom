<?xml version="1.0" encoding="UTF-8"?>
<!--
  AUTHORIZED SECURITY RESEARCH FIXTURE - GitHub Security Bug Bounty (HackerOne: github).
  Inert Maven metadata. Unauthenticated GET only.

  RUN 4 tests lead-03: src/proxy/internal/handlers/git_server.go attaches the job's
  github.com git_source credential to ANY path, because a credential with no
  accessible-repos is stored under allReposScopeIdentifier ("" , git_server.go:224)
  and getCredentialsForRequest returns it for every path except /_dependabot.

  d1 is a github.com path that is plainly NOT a git endpoint and NOT a repository.
  If the proxy logs "* authenticating git server request (host: github.com)" for it,
  the credential is being attached to an attacker-chosen non-git path in production.

  d2 is the known-blocked control so the job still reports a deterministic error.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.bbresearch</groupId>
  <artifactId>egress-probe-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <repositories>
    <repository>
      <id>d1-github-com-non-git-path</id>
      <url>https://github.com/pages/auth-probe-9f3a2b</url>
    </repository>
    <repository>
      <id>d2-baseline-blocked</id>
      <url>http://nonexistent-9f3a2b.github.net/d2</url>
    </repository>
  </repositories>
</project>
